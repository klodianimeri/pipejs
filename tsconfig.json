{
    "compilerOptions": {
        "target": "es6",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist",
        "removeComments": true,
        "declaration": true,
        "types": [
            "jest"
        ]
    },
    "exclude": [
        "src/tests",
        "src/bench",
        "node_modules",
        "tsup.config.ts",
        "dist/*.d.ts",
        "dist/**/*.d.ts"
    ]
}